{
	"name": "native-popovers",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./tooltip": "./src/tooltip/tooltip.tsx",
		"./popover": "./src/popover/popover.tsx",
		"./menu": "./src/menu/menu.tsx",
		"./hovercard": "./src/hovercard/hovercard.tsx",
		"./select": "./src/select/select.tsx",
		"./combobox": "./src/combobox/combobox.tsx",
		"./placement": "./src/layer/placement.ts"
	},
	"scripts": {
		"lint": "pnpm lint:tsc && pnpm lint:oxlint && pnpm format:check",
		"lint:tsc": "tsc --noEmit",
		"lint:oxlint": "oxlint --type-aware src e2e .storybook",
		"format": "oxfmt --write src e2e .storybook .agents README.md AGENTS.md package.json tsconfig.json .oxfmtrc.json playwright.config.ts vitest.config.ts oxlint.config.ts",
		"format:check": "oxfmt --check src e2e .storybook .agents README.md AGENTS.md package.json tsconfig.json .oxfmtrc.json playwright.config.ts vitest.config.ts oxlint.config.ts",
		"test": "vitest run",
		"storybook": "storybook dev -p 6116",
		"test:e2e": "playwright test"
	},
	"peerDependencies": {
		"react": "^19.0.0"
	},
	"devDependencies": {
		"@ariakit/react": "0.4.42",
		"@playwright/test": "^1.63.0",
		"@rolldown/plugin-babel": "^0.2.4",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/react-vite": "^10.6.0",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"oxfmt": "^0.70.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2004",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"storybook": "^10.6.0",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	},
	"packageManager": "pnpm@12.14.0"
}
